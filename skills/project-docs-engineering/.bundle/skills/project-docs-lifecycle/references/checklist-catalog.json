    {
      "id": "L4-RECOVERY",
      "stage": "L4",
      "check": "failure_recovery",
      "question": "失败是否区分本地记录和外部事实，如何核实、补偿或回退，谁负责？",
      "when": "涉及写入、外部调用或不可逆影响时",
      "required": false,
      "verification": "review",
