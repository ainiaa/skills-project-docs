{
  "schema_version": 1,
  "author": "Jeff.Liu",
  "version": "2026-11-16.2",
  "scope": "本仓方法基线；不证明行业标准穷尽、项目适用性判断正确或真实业务批准。",
  "items": [
    {
      "id": "L0-SOURCE",
      "stage": "L0",
      "check": "problem_source",
      "question": "原话、反馈人、时点和可查来源是否保留，整理内容是否仍能回到原始问题？",
      "when": "本期受理必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "受理正文和原始来源的对应位置",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "原始输入和阶段分析各自保留来源"
        }
      ]
    },
    {
      "id": "L0-CONTEXT",
      "stage": "L0",
      "check": "problem_source",
      "question": "场景、现象和影响分别有什么依据，是否将反馈或推测误写成事实？",
      "when": "本期受理必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "场景及事实/未知的具体陈述",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "区分事实/反馈/假设/技术未知"
        }
      ]
    },
    {
      "id": "L0-OWNER",
      "stage": "L0",
      "check": "scope_impact",
      "question": "范围、授权边界、负责人和下一调查动作能否确定？",
      "when": "本期受理必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "受理范围、Owner和下一动作",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "目标与授权范围是什么、由谁接手"
        }
      ]
    },
    {
      "id": "L1-CURRENT",
      "stage": "L1",
      "check": "current_state",
      "question": "实际入口、对象和操作链如何运行，证据对应哪个版本及环境？",
      "when": "本期调查必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "现状链及证据适用范围",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "当前业务如何运转、断点在哪"
        }
      ]
    },
    {
      "id": "L1-CAUSE",
      "stage": "L1",
      "check": "causes_evidence",
      "question": "每个候选原因有什么支持或反证，如何区分尚未验证的解释？",
      "when": "本期调查必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "复现、支持/反证及未核实原因",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "候选原因如何验证"
        }
      ]
    },
    {
      "id": "L1-UNKNOWN",
      "stage": "L1",
      "check": "causes_evidence",
      "question": "已有知识、权限、配置或数据缺口怎样取得证据，不确定性是否被隐去？",
      "when": "本期调查必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "未知项、Owner和取证动作",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "已有能力/知识/权限/配置/数据缺口是什么"
        }
      ]
    },
    {
      "id": "L2-OPTIONS",
      "stage": "L2",
      "check": "options_decision",
      "question": "是否比较研发、配置、指导、数据处理、流程调整或不做，选择和排除依据是什么？",
      "when": "本期分流必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "方案与排除理由、决定来源",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "为何选本期方案、排除哪些范围、谁决定"
        }
      ]
    },
    {
      "id": "L2-VALUE",
      "stage": "L2",
      "check": "value_scope",
      "question": "目标、价值依据和可观察的成功结果是否明确，没有数据时是否避免编造收益？",
      "when": "本期分流必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "价值依据、范围和效果证据缺口",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/input-and-quality.md",
          "sha256": "b76eea71a400c4a5e782ec6f01a3699a8fc4e72467e4caa9a53a51e753c81ff7",
          "quote": "目标没有量化依据时用可验证的业务结果"
        }
      ]
    },
    {
      "id": "L2-DECISION",
      "stage": "L2",
      "check": "options_decision",
      "question": "业务决定是否有适用范围和来源，仍未决的选择是否明确阻塞部分？",
      "when": "本期分流必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "决定/未决与进入PRD范围的对应",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-lifecycle/references/lifecycle.md",
          "sha256": "26b4f690e800a89c5ad6dcfff38511245b613140ded4c74d4a544749110d4abc",
          "quote": "决定来源及状态、目标与边界"
        }
      ]
    },
    {
      "id": "L3-RETENTION",
      "stage": "L3",
      "check": "acceptance",
      "question": "原始独立诉求、有效决定和保留约定是否逐项落入当前规则及验收？",
      "when": "生成、修订、评审PRD必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "原始诉求→正文规则→FR/AC或原有位置",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/workflow.md",
          "sha256": "de5c1bf94e53c37435cdbf8b73232456bf452645b9941dd3b7e82891e0e5fc9d",
          "quote": "原始诉求→正文规则→FR/AC"
        },
        {
          "kind": "local_regression",
          "path": "scripts/test_lifecycle_quality.py",
          "sha256": "c5c4a2c08f585066f135084ceb5692062803c3cf5a92116effdbb628090147a6",
          "quote": "test_supporting_sources_do_not_replace_even_an_identical_other_artifact"
        }
      ]
    },
    {
      "id": "L3-RULES",
      "stage": "L3",
      "check": "rules_exceptions",
      "question": "角色、输入、前提、状态转换和结束结果能否确定，建议/假设是否与决定分开？",
      "when": "本期PRD必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "具体对象按规则得到的结果及未决",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/input-and-quality.md",
          "sha256": "b76eea71a400c4a5e782ec6f01a3699a8fc4e72467e4caa9a53a51e753c81ff7",
          "quote": "触发条件、状态与结束结果"
        }
      ]
    },
    {
      "id": "L3-AC",
      "stage": "L3",
      "check": "acceptance",
      "question": "给定前提和操作后是否有可观察预期，正常、边界和非法输入如何验收？",
      "when": "本期PRD必查",
      "required": true,
      "verification": "review",
      "evidence_expected": "可推导的场景输入与预期，不只列标题",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/input-and-quality.md",
          "sha256": "b76eea71a400c4a5e782ec6f01a3699a8fc4e72467e4caa9a53a51e753c81ff7",
          "quote": "正常、边界、异常及相关历史场景的可观察预期"
        },
        {
          "kind": "lineage_record",
          "path": "skills/project-docs-product/references/design-basis.md",
          "sha256": "b32d191e8c76cba1b472a5183b011e490c19748724a01b6adf1e46ec0c61e0e9",
          "quote": "以前提、操作和可观察结果表达验收"
        }
      ]
    },
    {
      "id": "L3-RECOVERY",
      "stage": "L3",
      "check": "rules_exceptions",
      "question": "成功、确定失败、结果未知和部分成功如何区分；核实对象、入口、角色及重试条件是什么？",
      "when": "涉及执行、外部依赖、取消、重试或结果未知时",
      "required": false,
      "verification": "review",
      "evidence_expected": "逐出口推导、保持项和可执行恢复动作",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/workflow.md",
          "sha256": "de5c1bf94e53c37435cdbf8b73232456bf452645b9941dd3b7e82891e0e5fc9d",
          "quote": "区分成功、确定失败与结果未知"
        }
      ]
    },
    {
      "id": "L3-CALCULATION",
      "stage": "L3",
      "check": "rules_exceptions",
      "question": "输入、单位、公式、精度与阈值边界能否复算，是否混用来源总额和本次结果？",
      "when": "涉及计算、金额、配额或累计值时",
      "required": false,
      "verification": "review",
      "evidence_expected": "同组具体输入及逐步数值/边界结果",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/workflow.md",
          "sha256": "de5c1bf94e53c37435cdbf8b73232456bf452645b9941dd3b7e82891e0e5fc9d",
          "quote": "涉及计算才复算数值"
        }
      ]
    },
    {
      "id": "L3-HISTORY",
      "stage": "L3",
      "check": "rules_exceptions",
      "question": "旧数据、在途对象和既有规则如何适用，改变与保持项有无对应回归？",
      "when": "改造已有系统或存在历史/在途数据时",
      "required": false,
      "verification": "review",
      "evidence_expected": "前后对照、兼容限制和历史场景",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/input-and-quality.md",
          "sha256": "b76eea71a400c4a5e782ec6f01a3699a8fc4e72467e4caa9a53a51e753c81ff7",
          "quote": "历史/在途适用性和验收"
        }
      ]
    },
    {
      "id": "L3-PERMISSION",
      "stage": "L3",
      "check": "rules_exceptions",
      "question": "角色权限、可见性和跨角色接手的前提是否明确，非法操作结果是什么？",
      "when": "涉及多角色、敏感数据或权限变化时",
      "required": false,
      "verification": "review",
      "evidence_expected": "角色/状态组合与非法访问预期",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/input-and-quality.md",
          "sha256": "b76eea71a400c4a5e782ec6f01a3699a8fc4e72467e4caa9a53a51e753c81ff7",
          "quote": "角色与权限要求"
        }
      ]
    },
    {
      "id": "L3-PROTOTYPE",
      "stage": "L3",
      "check": "acceptance",
      "question": "图、页面和原型是否覆盖本期任务且与规则/AC一致，模拟边界及未覆盖怎样说明？",
      "when": "要求图、原型或UI交互变更时",
      "required": false,
      "verification": "review",
      "evidence_expected": "实际页面及连续旅程、对应FR/AC和缺口",
      "sources": [
        {
          "kind": "local_method",
          "path": "skills/project-docs-product/references/prototype.md",
          "sha256": "93354edfb99bad4c971d66ac778a21ec4ef4c17276fd29f8dd3143e0a382fac4",
          "quote": "覆盖表中每个本期关键任务必须有实际浏览器结果"
        }
      ]
    },
